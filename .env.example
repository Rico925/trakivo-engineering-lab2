# Copy to .env beside the project root or export these variables in the backend shell. Never commit real keys.
# Supported providers: groq, blackbox
AI_PROVIDER=groq

# Groq (recommended default)
GROQ_API_KEY=replace-with-your-groq-api-key
GROQ_MODEL=llama-3.3-70b-versatile
GROQ_BASE_URL=https://api.groq.com/openai/v1

# Optional alternative provider. Set AI_PROVIDER=blackbox to use these instead.
BLACKBOX_API_KEY=replace-with-your-blackbox-api-key
BLACKBOX_MODEL=blackboxai/openai/gpt-5.5
BLACKBOX_BASE_URL=https://enterprise.blackbox.ai
